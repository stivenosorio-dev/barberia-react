{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "coordinador",
  "compaction": { "auto": true, "prune": true },
  "permission": {
    "context7_*": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      ".dev.vars": "deny",
      "package-lock.json": "deny",
      "dist/**": "deny",
      "public/images/**": "deny"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": { "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}" },
      "enabled": true
    }
  }
}
